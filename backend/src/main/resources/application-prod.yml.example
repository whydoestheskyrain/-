# 复制为 application-prod.yml 后使用 Docker Compose 环境变量替换尖括号内容。
server:
  port: 8080
  address: 0.0.0.0

spring:
  datasource:
    url: jdbc:mysql://${DB_HOST:mysql}:${DB_PORT:3306}/${DB_NAME:trade_db}?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
    username: ${DB_USERNAME:root}
    password: ${DB_PASSWORD:<填写数据库密码>}
    driver-class-name: com.mysql.cj.jdbc.Driver
  sql:
    init:
      mode: never
  redis:
    host: ${REDIS_HOST:redis}
    port: ${REDIS_PORT:6379}
    password: ${REDIS_PASSWORD:}
    database: 0

mybatis:
  mapper-locations: classpath:mapper/*.xml
  type-aliases-package: com.trade.virtual_trade.entity
  configuration:
    map-underscore-to-camel-case: true

alipay:
  return-url: http://${APP_SERVER_HOST}/#/user/center
  notify-url: http://${APP_SERVER_HOST}/alipay/notify
  recharge-notify-url: http://${APP_SERVER_HOST}/recharge/notify

file:
  upload:
    path: /app/uploads

app:
  front-url: http://${APP_SERVER_HOST}
  server-url: http://${APP_SERVER_HOST}
  cors-origins: ${APP_CORS_ORIGINS}
