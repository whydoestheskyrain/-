# ============================================================
# 部署环境变量模板：复制为 .env 后填写真实值；.env 已在 .gitignore 中，禁止提交
# cp .env.example .env
# ============================================================

# MySQL root 密码（docker-compose 启动 MySQL 时使用）
MYSQL_ROOT_PASSWORD=请修改为强密码

# Redis 密码（docker-compose 中 Redis 默认无密码，如需开启请同步修改 redis 启动命令）
REDIS_PASSWORD=

# 对外访问地址（云服务器公网 IP 或域名，不要带 http:// 和端口）
APP_SERVER_HOST=127.0.0.1

# 允许跨域的来源，多个用逗号分隔
APP_CORS_ORIGINS=http://127.0.0.1:8080

# JWT 签名密钥：至少 32 位随机字符串，可用 `openssl rand -base64 48` 生成
JWT_SECRET=请替换为至少32位随机字符串

# ===== 支付宝沙箱（https://open.alipay.com/develop/sandbox/app） =====
ALIPAY_APP_ID=沙箱应用APPID
ALIPAY_APP_PRIVATE_KEY=沙箱应用私钥
ALIPAY_PUBLIC_KEY=支付宝公钥

# ===== 阿里云百炼 DashScope（AI 桌宠，https://bailian.console.aliyun.com/） =====
DASHSCOPE_API_KEY=百炼API-Key
DASHSCOPE_APP_ID=百炼应用ID
